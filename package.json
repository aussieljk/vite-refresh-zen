{
  "name": "vite-refresh-zen",
  "version": "0.2.3",
  "description": "Pause and resume Vite HMR - batch file changes and apply them all at once",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "refresh-zen": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target node && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "bun build ./src/index.ts --outdir ./dist --target node --watch",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "check": "bun run workflows:check && bun run typecheck && bun run build",
    "release": "bun scripts/release.ts",
    "workflows": "bun ci/generate.ts",
    "workflows:check": "bun ci/generate.ts --check"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "@types/bun": "latest"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "hmr",
    "hot-module-replacement",
    "batch",
    "pause",
    "refresh"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aussieljk/vite-refresh-zen.git"
  },
  "packageManager": "bun@1.3.11"
}
